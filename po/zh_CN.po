#: src/prefs.js:17
msgid "Disable all"
msgstr "全部排除"

#: src/prefs.js:18
msgid "Disable corners"
msgstr "排除圆角"

#: src/prefs.js:19
msgid "Disable shadow"
msgstr "排除阴影"

#: src/prefs.js:124 src/prefs.js:132
msgid "OK"
msgstr "确定"

#: src/prefs.js:144
msgid "General"
msgstr "常规"

#: src/prefs.js:151
msgid "Display & Rendering"
msgstr "显示与渲染"

#: src/prefs.js:152
msgid "Control window decoration behavior across screen scales"
msgstr "控制窗口装饰在不同屏幕缩放下的渲染行为"

#: src/prefs.js:157
msgid "Prioritize Crisp Text"
msgstr "优先保证文字清晰"

#: src/prefs.js:158
msgid ""
"Skip rounded corners on fractional scale monitors (retaining shadow) to "
"avoid text blur and resampling overhead"
msgstr ""
"在分数缩放屏幕上免除圆角（保留阴影），消除重采样带来的字体模糊与性能损耗"

#: src/prefs.js:165
msgid "Inspect Window…"
msgstr "拾取窗口…"

#: src/prefs.js:167
msgid ""
"Click an on-screen window to automatically detect and add exclusion rule"
msgstr "点击屏幕上的窗口以自动识别并添加排除规则"

#: src/prefs.js:171
msgid "Application Exclusion Rules"
msgstr "应用排除规则"

#: src/prefs.js:172
msgid ""
"Configure individual exclusions for specific windows (disable all, skip "
"corners, or skip shadow)"
msgstr "为特定窗口单独配置禁用项（禁用全部、禁用圆角或禁用阴影）"

#: src/prefs.js:192
msgid "No Special Rules"
msgstr "暂无特殊规则"

#: src/prefs.js:193
msgid ""
"All normal windows without server-side decorations will have native shadow "
"and rounded corners applied by default"
msgstr "所有未包含服务端边框的普通窗口将默认添加原生阴影与圆角剪裁"

#: src/prefs.js:206
msgid "Custom Identifier"
msgstr "自定义识别码"

#: src/prefs.js:210 src/prefs.js:211
msgid "Dialogs & Popups"
msgstr "弹窗与对话框"

#: src/prefs.js:212
msgid "Child dialogs and transient windows"
msgstr "子对话框与附属瞬态窗口"

#: src/prefs.js:216
msgid "Specific window title"
msgstr "特定窗口标题"

#: src/prefs.js:261
msgid "Remove Rule"
msgstr "删除规则"

#: src/prefs.js:286
msgid "Window Inspection Failed"
msgstr "窗口拾取失败"

#: src/prefs.js:287
msgid ""
"Could not connect to CSD Fixer extension. Please ensure the extension is "
"enabled."
msgstr "无法连接到 CSD Fixer 扩展，请确认该扩展已在 GNOME 扩展中启用。"

#: src/prefs.js:301
#, javascript-format
msgid "Rule for \"%s\" already exists"
msgstr "“%s”的规则已存在"

#: src/prefs.js:312
#, javascript-format
msgid "Added rule for \"%s\""
msgstr "已为“%s”添加排除规则"

