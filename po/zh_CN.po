#: src/prefs.js:13
msgid "Disable all (no shadow, no rounded corners)"
msgstr "全部禁用（不加阴影，不裁圆角）"

#: src/prefs.js:14
msgid "Disable all"
msgstr "全部禁用"

#: src/prefs.js:18
msgid "Shadow only (disable rounded corners)"
msgstr "仅阴影（禁用圆角裁切）"

#: src/prefs.js:19
msgid "Shadow only"
msgstr "仅阴影"

#: src/prefs.js:23
msgid "Rounded corners only (disable shadow)"
msgstr "仅圆角（禁用阴影添加）"

#: src/prefs.js:24
msgid "Corners only"
msgstr "仅圆角"

#: src/prefs.js:103
msgid "Add Application Exclusion Rule"
msgstr "添加应用排除规则"

#: src/prefs.js:130
msgid "Search installed applications…"
msgstr "搜索已安装应用…"

#: src/prefs.js:190
msgid "Rule Parameters"
msgstr "规则参数"

#: src/prefs.js:195
msgid "Window Identifier (wm_class)"
msgstr "窗口识别码 (wm_class)"

#: src/prefs.js:209
msgid "Exclusion Behavior"
msgstr "排除行为"

#: src/prefs.js:217
msgid "Add Rule"
msgstr "添加规则"

#: src/prefs.js:247
msgid "General"
msgstr "常规"

#: src/prefs.js:254
msgid "Display & Rendering"
msgstr "显示与渲染"

#: src/prefs.js:255
msgid "Control window decoration behavior across screen scales"
msgstr "控制窗口装饰在不同屏幕缩放下的渲染行为"

#: src/prefs.js:260
msgid "Prioritize Crisp Text"
msgstr "优先保证文字清晰"

#: src/prefs.js:261
msgid ""
"Skip rounded corners on fractional scale monitors (retaining shadow) to "
"avoid text blur and resampling overhead"
msgstr ""
"在分数缩放屏幕上免除圆角（保留阴影），消除重采样带来的字体模糊与性能损耗"

#: src/prefs.js:268
msgid "Add Rule…"
msgstr "添加规则…"

#: src/prefs.js:274
msgid "Application Exclusion Rules"
msgstr "应用排除规则"

#: src/prefs.js:275
msgid ""
"Configure individual exclusions for specific windows (disable all, skip "
"corners, or skip shadow)"
msgstr "为特定窗口单独配置禁用项（禁用全部、禁用圆角或禁用阴影）"

#: src/prefs.js:293
msgid "No Special Rules"
msgstr "暂无特殊规则"

#: src/prefs.js:294
msgid ""
"All normal windows without server-side decorations will have native shadow "
"and rounded corners applied by default"
msgstr "所有未包含服务端边框的普通窗口将默认添加原生阴影与圆角剪裁"

#: src/prefs.js:305
msgid "Custom Identifier"
msgstr "自定义识别码"

#: src/prefs.js:351
msgid "Remove Rule"
msgstr "删除规则"
