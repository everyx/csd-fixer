#: src/prefs.js:32
msgid "Shadow"
msgstr "阴影"

#: src/prefs.js:32
msgid "Corners"
msgstr "圆角"

#: src/prefs.js:43
msgid "dialog"
msgstr "对话框"

#: src/prefs.js:44
msgid "modal dialog"
msgstr "模态对话框"

#: src/prefs.js:45
msgid "utility window"
msgstr "工具窗口"

#: src/prefs.js:49
msgid "window"
msgstr "窗口"

#: src/prefs.js:65
msgid "Fixed-size"
msgstr "固定尺寸"

#: src/prefs.js:65
msgid "Resizable"
msgstr "可缩放"

#: src/prefs.js:66
msgid "X11"
msgstr "X11"

#: src/prefs.js:66
msgid "Wayland"
msgstr "Wayland"

#: src/prefs.js:70
msgid "with no parent"
msgstr "无父窗口"

#: src/prefs.js:72
msgid "attached to its parent"
msgstr "附加到父窗口"

#: src/prefs.js:74
msgid "with a parent"
msgstr "有父窗口"

#. The template is the translatable unit, so a language can reorder the
#. sentence; each fragment above is translated on its own.
#: src/prefs.js:78
msgid "{size} {server} {type}, {parent}"
msgstr "{size}的 {server} {type}，{parent}"

#: src/prefs.js:184 src/prefs.js:192
msgid "OK"
msgstr "确定"

#: src/prefs.js:212
msgid "General"
msgstr "常规"

#: src/prefs.js:218
msgid "Display & Rendering"
msgstr "显示与渲染"

#: src/prefs.js:219
msgid "Control window decoration behavior across screen scales"
msgstr "控制窗口装饰在不同屏幕缩放下的渲染行为"

#: src/prefs.js:224
msgid "Prioritize Crisp Text"
msgstr "优先保证文字清晰"

#: src/prefs.js:225
msgid ""
"Skip rounded corners on fractional scale monitors (retaining shadow) to "
"avoid text blur and resampling overhead"
msgstr ""
"在分数缩放屏幕上免除圆角（保留阴影），消除重采样带来的字体模糊与性能损耗"

#: src/prefs.js:237
msgid "Suppress Rules"
msgstr "屏蔽规则"

#: src/prefs.js:238
msgid "Turn a decoration on to suppress it for these windows."
msgstr "打开某个装饰开关，即对这些窗口屏蔽该装饰。"

#: src/prefs.js:239
msgid "Leave a window undecorated"
msgstr "让某个窗口不补装饰"

#: src/prefs.js:240
msgid "Use the button above to leave a window undecorated."
msgstr "用上面的按钮拾取一个窗口，让它不补装饰。"

#: src/prefs.js:244
msgid "Force Rules"
msgstr "强制规则"

#: src/prefs.js:245
msgid "Turn a decoration on to force it for these windows."
msgstr "打开某个装饰开关，即对这些窗口强制加上该装饰。"

#: src/prefs.js:246
msgid "Decorate a window anyway"
msgstr "强制给某个窗口补装饰"

#: src/prefs.js:247
msgid "Use the button above to decorate a window anyway."
msgstr "用上面的按钮拾取一个窗口，强制给它补装饰。"

#: src/prefs.js:338
msgid "Remove Rule"
msgstr "删除规则"

#: src/prefs.js:400
msgid "Window Inspection Failed"
msgstr "窗口拾取失败"

#: src/prefs.js:401
msgid ""
"Could not connect to Window Nativizer extension. Please ensure the extension "
"is enabled."
msgstr "无法连接到 Window Nativizer 扩展，请确认该扩展已在 GNOME 扩展中启用。"

#: src/prefs.js:415
msgid "No rule added: this window could not be identified."
msgstr "未添加规则：无法识别这个窗口。"

#: src/prefs.js:429
msgid "No rule added: it would have no effect on a window of this kind."
msgstr "未添加规则：这条规则对此类窗口不会有任何效果。"

#: src/prefs.js:449
msgid "No rule added: the rule could not be saved."
msgstr "未添加规则：规则未能保存。"

#: src/prefs.js:459
#, javascript-format
msgid "Moved to %s"
msgstr "已移动到“%s”"
