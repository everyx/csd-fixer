#: src/prefs.js:13
msgid "Disable all (no shadow, no rounded corners)"
msgstr "全部停用（不加陰影，不修圓角）"

#: src/prefs.js:14
msgid "Disable all"
msgstr "全部停用"

#: src/prefs.js:18
msgid "Shadow only (disable rounded corners)"
msgstr "僅陰影（停用圓角修邊）"

#: src/prefs.js:19
msgid "Shadow only"
msgstr "僅陰影"

#: src/prefs.js:23
msgid "Rounded corners only (disable shadow)"
msgstr "僅圓角（停用陰影效果）"

#: src/prefs.js:24
msgid "Corners only"
msgstr "僅圓角"

#: src/prefs.js:103
msgid "Add Application Exclusion Rule"
msgstr "新增應用程式排除規則"

#: src/prefs.js:130
msgid "Search installed applications…"
msgstr "搜尋已安裝的應用程式…"

#: src/prefs.js:190
msgid "Rule Parameters"
msgstr "規則參數"

#: src/prefs.js:195
msgid "Window Identifier (wm_class)"
msgstr "視窗識別碼 (wm_class)"

#: src/prefs.js:209
msgid "Exclusion Behavior"
msgstr "排除行為"

#: src/prefs.js:217
msgid "Add Rule"
msgstr "新增規則"

#: src/prefs.js:247
msgid "General"
msgstr "一般"

#: src/prefs.js:254
msgid "Display & Rendering"
msgstr "顯示與渲染"

#: src/prefs.js:255
msgid "Control window decoration behavior across screen scales"
msgstr "控制視窗裝飾在不同螢幕縮放下的渲染行為"

#: src/prefs.js:260
msgid "Prioritize Crisp Text"
msgstr "優先保證文字清晰"

#: src/prefs.js:261
msgid ""
"Skip rounded corners on fractional scale monitors (retaining shadow) to "
"avoid text blur and resampling overhead"
msgstr ""
"在分數縮放螢幕上免除圓角（保留陰影），消除重新取樣帶來的字體模糊與效能損耗"

#: src/prefs.js:268
msgid "Add Rule…"
msgstr "新增規則…"

#: src/prefs.js:274
msgid "Application Exclusion Rules"
msgstr "應用程式排除規則"

#: src/prefs.js:275
msgid ""
"Configure individual exclusions for specific windows (disable all, skip "
"corners, or skip shadow)"
msgstr "為特定視窗單獨設定排除項（全部停用、免除圓角或免除陰影）"

#: src/prefs.js:293
msgid "No Special Rules"
msgstr "尚無特殊規則"

#: src/prefs.js:294
msgid ""
"All normal windows without server-side decorations will have native shadow "
"and rounded corners applied by default"
msgstr "所有未包含伺服器端邊框的標準視窗預設將套用原生陰影與圓角裁切"

#: src/prefs.js:305
msgid "Custom Identifier"
msgstr "自訂識別碼"

#: src/prefs.js:351
msgid "Remove Rule"
msgstr "刪除規則"
