#: src/prefs.js:32
msgid "Shadow"
msgstr "陰影"

#: src/prefs.js:32
msgid "Corners"
msgstr "圓角"

#: src/prefs.js:43
msgid "dialog"
msgstr "對話框"

#: src/prefs.js:44
msgid "modal dialog"
msgstr "模態對話框"

#: src/prefs.js:45
msgid "utility window"
msgstr "工具視窗"

#: src/prefs.js:49
msgid "window"
msgstr "視窗"

#: src/prefs.js:65
msgid "Fixed-size"
msgstr "固定尺寸"

#: src/prefs.js:65
msgid "Resizable"
msgstr "可縮放"

#: src/prefs.js:66
msgid "X11"
msgstr "X11"

#: src/prefs.js:66
msgid "Wayland"
msgstr "Wayland"

#: src/prefs.js:70
msgid "with no parent"
msgstr "無父視窗"

#: src/prefs.js:72
msgid "attached to its parent"
msgstr "附加到父視窗"

#: src/prefs.js:74
msgid "with a parent"
msgstr "有父視窗"

#. The template is the translatable unit, so a language can reorder the
#. sentence; each fragment above is translated on its own.
#: src/prefs.js:78
msgid "{size} {server} {type}, {parent}"
msgstr "{size}的 {server} {type}，{parent}"

#: src/prefs.js:184 src/prefs.js:192
msgid "OK"
msgstr "確定"

#: src/prefs.js:212
msgid "General"
msgstr "一般"

#: src/prefs.js:218
msgid "Display & Rendering"
msgstr "顯示與渲染"

#: src/prefs.js:219
msgid "Control window decoration behavior across screen scales"
msgstr "控制視窗裝飾在不同螢幕縮放下的渲染行為"

#: src/prefs.js:224
msgid "Prioritize Crisp Text"
msgstr "優先保證文字清晰"

#: src/prefs.js:225
msgid ""
"Skip rounded corners on fractional scale monitors (retaining shadow) to "
"avoid text blur and resampling overhead"
msgstr ""
"在分數縮放螢幕上免除圓角（保留陰影），消除重新取樣帶來的字體模糊與效能損耗"

#: src/prefs.js:237
msgid "Suppress Rules"
msgstr "屏蔽規則"

#: src/prefs.js:238
msgid "Turn a decoration on to suppress it for these windows."
msgstr "開啟某個裝飾開關，即對這些視窗屏蔽該裝飾。"

#: src/prefs.js:239
msgid "Leave a window undecorated"
msgstr "讓某個視窗不加上裝飾"

#: src/prefs.js:240
msgid "Use the button above to leave a window undecorated."
msgstr "用上面的按鈕選取一個視窗，讓它不加上裝飾。"

#: src/prefs.js:244
msgid "Force Rules"
msgstr "強制規則"

#: src/prefs.js:245
msgid "Turn a decoration on to force it for these windows."
msgstr "開啟某個裝飾開關，即對這些視窗強制加上該裝飾。"

#: src/prefs.js:246
msgid "Decorate a window anyway"
msgstr "強制為某個視窗加上裝飾"

#: src/prefs.js:247
msgid "Use the button above to decorate a window anyway."
msgstr "用上面的按鈕選取一個視窗，強制為它加上裝飾。"

#: src/prefs.js:338
msgid "Remove Rule"
msgstr "刪除規則"

#: src/prefs.js:400
msgid "Window Inspection Failed"
msgstr "視窗選取失敗"

#: src/prefs.js:401
msgid ""
"Could not connect to CSD Fixer extension. Please ensure the extension is "
"enabled."
msgstr ""
"無法連線至 CSD Fixer 擴充套件，請確認該擴充套件已在 GNOME 擴充套件中啟用。"

#: src/prefs.js:415
msgid "No rule added: this window could not be identified."
msgstr "未新增規則：無法識別這個視窗。"

#: src/prefs.js:429
msgid "No rule added: it would have no effect on a window of this kind."
msgstr "未新增規則：這條規則對此類視窗不會有任何效果。"

#: src/prefs.js:449
msgid "No rule added: the rule could not be saved."
msgstr "未新增規則：規則未能儲存。"

#: src/prefs.js:459
#, javascript-format
msgid "Moved to %s"
msgstr "已移動到「%s」"
